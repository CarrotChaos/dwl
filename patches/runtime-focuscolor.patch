+static int
+loadfocuscolor(void)
+{
+	FILE *fp;
+	unsigned int color;
+	char path[PATH_MAX];
+	const char *home;
+
+	if (!(home = getenv("HOME")))
+		return 0;
+
+	if (snprintf(path, sizeof(path), "%s/%s", home, focuscolorfile)
+			>= (int)sizeof(path))
+		return 0;
+
+	if (!(fp = fopen(path, "r")))
+		return 0;
+
+	if (fscanf(fp, "%x", &color) != 1) {
+		fclose(fp);
+		return 0;
+	}
+	fclose(fp);
+
+	focuscolor[0] = ((color >> 24) & 0xff) / 255.0f;
+	focuscolor[1] = ((color >> 16) & 0xff) / 255.0f;
+	focuscolor[2] = ((color >> 8) & 0xff) / 255.0f;
+	focuscolor[3] = (color & 0xff) / 255.0f;
+
+	return 1;
+}
+
+int
+reloadfocuscolor(int signal, void *data)
+{
+	Client *c;
+
+	(void)signal;
+	(void)data;
+
+	if (!loadfocuscolor())
+		return 0;
+
+	if ((c = focustop(selmon)) && !c->isurgent)
+		client_set_border_color(c, focuscolor);
+
+	return 0;
+}
